* text=auto

# Source files
*.cs        text eol=lf
*.csx       text eol=lf
*.axaml     text eol=lf
*.xml       text eol=lf

# .NET project and build files
*.sln       text eol=lf
*.slnx      text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf

# Documentation and configuration
*.md        text eol=lf
*.txt       text eol=lf
*.json      text eol=lf
*.jsonc     text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.config    text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Shell scripts use LF; Windows command scripts retain their native endings.
*.sh        text eol=lf
*.ps1       text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf
